# OpenAI-compatible LLM API
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional system prompt for spoken replies
LLM_SYSTEM_PROMPT=You are a helpful voice assistant. Keep answers concise and conversational, usually 1-3 short sentences, since they will be spoken aloud.

# Moonshine STT (runs on CPU to leave VRAM for CosyVoice)
# Options: tiny_streaming | small_streaming | medium_streaming
MOONSHINE_MODEL_ARCH=small_streaming
MOONSHINE_LANGUAGE=en

# CosyVoice2 TTS
COSYVOICE_MODEL_DIR=pretrained_models/CosyVoice2-0.5B
COSYVOICE_REPO_DIR=third_party/CosyVoice
COSYVOICE_PROMPT_WAV=assets/prompt.wav
# Must match the spoken content of COSYVOICE_PROMPT_WAV
# Default wav is CosyVoice's asset/zero_shot_prompt.wav:
COSYVOICE_PROMPT_TEXT=希望你以后能够做的比我还好呦。
COSYVOICE_FP16=true

# Conversation behavior
# Seconds of silence after speech before treating the utterance as complete
# (Moonshine already VAD-segments; this is an extra debounce between turns)
TURN_DEBOUNCE_MS=400
